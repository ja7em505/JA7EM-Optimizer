{
    "name": "cj-optimizer",
    "version": "1.0.0",
    "description": "CJ PC Optimizer - Boost FPS, Update Drivers, Clean System",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build": "electron-builder build --win --publish never",
        "pack": "electron-builder build --dir",
        "pack-portable": "electron-packager . \"CJ Optimizer\" --platform=win32 --arch=x64 --icon=assets/icon.ico --overwrite --out=dist --asar",
        "obfuscate": "node scripts/obfuscate.js",
        "integrity": "node scripts/gen-integrity.js",
        "icon": "node scripts/png-to-ico.js",
        "build-secure": "node scripts/obfuscate.js && node scripts/gen-integrity.js && electron-builder build --win --publish never"
    },
    "author": "CJ",
    "license": "MIT",
    "devDependencies": {
        "electron": "^37.0.0",
        "electron-builder": "^25.0.0",
        "electron-packager": "^17.1.2",
        "javascript-obfuscator": "^5.5.0",
        "png-to-ico": "^3.0.2",
        "sharp": "^0.35.3"
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "systeminformation": "^5.22.0",
        "tesseract.js": "^7.0.0"
    },
    "build": {
        "appId": "com.cjteam.optimizer",
        "productName": "CJ Optimizer",
        "files": [
            "src/**/*",
            "assets/**/*",
            "scripts/**/*",
            "package.json",
            "README.md"
        ],
        "publish": {
            "provider": "github",
            "owner": "ja7em505",
            "repo": "JA7EM-Optimizer"
        },
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico",
            "sign": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
